# 复制成 agent-home/.env 再填自己的值（.env 在 .gitignore 里，不会进仓库）
#   cp agent-home/.env.example agent-home/.env

# 必填：LongCat 开放平台的 API Key（https://longcat.chat/platform）
LONGCAT_API_KEY=

# 子 agent（后台任务、目标检查）的模型，不填用以下默认值
# PI_MODEL=LongCat-2.5-Preview
# PI_API_URL=https://api.longcat.chat/openai/v1
# PI_API_KEY=                         # 默认沿用 LONGCAT_API_KEY
# PI_CONTEXT_WINDOW=128000
# PI_MAX_TOKENS=8192
# PI_MAX_TURNS=90

# 主 agent（聊天）的模型：要快、要能看图
# DISPATCH_MODEL=LongCat-2.5-Preview
# DISPATCH_API_URL=https://api.longcat.chat/openai/v1
# DISPATCH_API_KEY=                   # 默认沿用 LONGCAT_API_KEY
# DISPATCH_MAX_TURNS=10
# DISPATCH_MAX_TOKENS=1024

# 国外网站要走的代理（沙箱浏览器、图片代理用；国内站点始终直连）
# HTTPS_PROXY=http://127.0.0.1:7890
