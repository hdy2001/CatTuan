# 复制成 agent-home/.env 再填自己的值（.env 在 .gitignore 里，不会进仓库）
#   cp agent-home/.env.example agent-home/.env

# 必填：LongCat 开放平台的 API Key（https://longcat.chat/platform）
LONGCAT_API_KEY=

# Pi 执行 runtime（不填则使用以下默认值；调度层仍单独使用 DISPATCH_MODEL）
# PI_MODEL=LongCat-2.5-Preview
# PI_API_URL=https://api.longcat.chat/openai/v1
# PI_API_KEY=                         # 默认沿用 LONGCAT_API_KEY
# PI_CONTEXT_WINDOW=128000
# PI_MAX_TOKENS=8192
# PI_MAX_TURNS=90

# 本地 agent 的 API server：scripts/start-agent.sh 第一次运行时会自动补上（带随机 key），不用手填
# API_SERVER_ENABLED=true
# API_SERVER_HOST=127.0.0.1
# API_SERVER_PORT=8650
# API_SERVER_KEY=
