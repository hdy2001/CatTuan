# 复制成 agent-home/.env 再填自己的值（.env 在 .gitignore 里，不会进仓库）
#   cp agent-home/.env.example agent-home/.env

# 必填：LongCat 开放平台的 API Key（https://longcat.chat/platform）
LONGCAT_API_KEY=

# 子 agent（后台任务、目标检查）的模型，不填用以下默认值
# PI_MODEL=LongCat-2.5-Preview
# PI_API_URL=https://api.longcat.chat/openai/v1
# PI_API_KEY=                         # 默认沿用 LONGCAT_API_KEY
# PI_CONTEXT_WINDOW=128000
# PI_MAX_TOKENS=16384                # 思考也算输出
# PI_MAX_TURNS=90
# PI_TIMEOUT_MS=180000                # 模型多久没开始回就算超时（超时重试一次）
# PI_THINKING=1                       # 子 agent 先思考再调工具，设成 0 关掉

# 主 agent（聊天）的模型：要快、要能看图
# DISPATCH_MODEL=LongCat-2.5-Preview
# DISPATCH_API_URL=https://api.longcat.chat/openai/v1
# DISPATCH_API_KEY=                   # 默认沿用 LONGCAT_API_KEY
# DISPATCH_MAX_TURNS=10
# DISPATCH_MAX_TOKENS=8192            # 思考也算输出
# DISPATCH_TIMEOUT_MS=60000
# DISPATCH_THINKING=1                 # 主 agent 先思考再回话，设成 0 关掉

# 国外网站要走的代理（沙箱浏览器、图片代理、搜索服务用；沙箱里国内站点始终直连）
# HTTPS_PROXY=http://127.0.0.1:7890
# SEARCH_PROXY=                       # 只给搜索服务 DDGS 用的代理，默认沿用 HTTPS_PROXY

# 搜索服务 DDGS 的地址（scripts/start-search.sh 起在本机 4479，SEARCH_PORT 可以换端口）
# DDGS_URL=http://127.0.0.1:4479

# 打电话：木星外呼平台（mt-jupiter-cli call aicall）。不配租户和路由点时 phone_call 直接返回「外呼平台没配置」。
# 这些可以放在这里或 /etc/cattuan.env（全站共用），也可以写进某个账号自己的 <home>/.env（只对他生效，覆盖全站的）。
# CLI 的安装方法见学城《木星系统官方CLI使用指南》。
# JUPITER_CLI=mt-jupiter-cli          # CLI 路径，不在 App 的 PATH 里时写绝对路径（官方脚本装在 ~/.openclaw/clihub/bin/mt-jupiter-cli）
# JUPITER_ENV=test                    # prod（默认，线上）/ test（线下）
# JUPITER_TENANT_ID=                  # 租户 ID
# JUPITER_ROUTE_POINT=                # AI 路由点（决定服务端用哪个外呼 Agent）
# JUPITER_DISPLAY_NUM=                # 外显号码，不填由平台选；或者用 JUPITER_NUMBER_POOL 指定号码池
# JUPITER_POLL_SECONDS=10             # 拨出去以后隔多久查一次话单
# JUPITER_RESULT_MINUTES=10           # 最多等多久的结果，等不到就先告诉用户电话打出去了、结果还没出来
#
# 鉴权：CLI 默认自己调本机的 mtsso-moa-local-exchange 用 MOA 换 SSO token（moa，要先装这个换票工具）。服务器上没有 MOA 时二选一：
#   token：直接给 SSO token（会过期，要定期换）
#   command：每次外呼前跑这条命令，它输出的就是 token（换票脚本、密钥管理工具都行）
# JUPITER_AUTH=moa                    # moa / token / command
# JUPITER_SSO_TOKEN=
# JUPITER_AUTH_COMMAND=
