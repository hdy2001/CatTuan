# 复制成 hermes-home/.env 再填自己的值（.env 在 .gitignore 里，不会进仓库）
#   cp hermes-home/.env.example hermes-home/.env

# 必填：LongCat 开放平台的 API Key（https://longcat.chat/platform）
LONGCAT_API_KEY=

# 本地 agent 的 API server：scripts/start-agent.sh 第一次运行时会自动补上（带随机 key），不用手填
# API_SERVER_ENABLED=true
# API_SERVER_HOST=127.0.0.1
# API_SERVER_PORT=8650
# API_SERVER_KEY=
