[Unit]
Description=CatTuan 沙箱浏览器（:8660，大家共用一个无头 Chromium）
After=network-online.target
Wants=network-online.target

[Service]
User=cattuan
WorkingDirectory=/srv/cattuan
EnvironmentFile=/etc/cattuan/cattuan.env
Environment=TZ=Asia/Shanghai
ExecStart=/srv/cattuan/scripts/start-sandbox.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
