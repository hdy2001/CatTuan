[Unit]
Description=CatTuan 执行 agent（每个用户一个 Hermes gateway，由 scripts/agents.mjs 守护）
After=network-online.target cattuan-sandbox.service
Wants=network-online.target

[Service]
User=cattuan
WorkingDirectory=/srv/cattuan
EnvironmentFile=/etc/cattuan/cattuan.env
Environment=TZ=Asia/Shanghai
ExecStart=/usr/bin/node scripts/agents.mjs
Restart=on-failure
RestartSec=5
# 先只给守护进程发 SIGTERM，由它挨个停掉各人的 gateway；超时还没退的再一起杀掉
KillMode=mixed
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
