# /etc/cattuan/cattuan.env：App、沙箱、agent 守护进程共用的线上配置（systemd 的 EnvironmentFile）。
# LongCat 的 key 不放这里，放 /srv/cattuan/agent-home/.env（App 和每个人的 agent 都从那里读）。

# 对外地址（deploy/setup.sh 会按你给的域名填好）
PUBLIC_ORIGIN=https://APP_DOMAIN
SITES_ORIGIN=https://SITES_DOMAIN

# 后台任务并发：全局最多几个同时跑（沙箱浏览器是串行的，开太多也只是排队），每人最多几个
MAX_RUNNING=4
MAX_RUNNING_PER_USER=2

# 普通成员每天的用量上限（管理员不限）。大家共用一个 LongCat key，主要防目标检查和后台任务把额度跑光。
QUOTA_MESSAGES_PER_DAY=300
QUOTA_TASKS_PER_DAY=40
QUOTA_GOAL_CHECKS_PER_DAY=48
# 普通成员最多几个进行中的目标、目标最短几分钟检查一次
QUOTA_GOALS=5
QUOTA_GOAL_MIN_EVERY=60

# 访问 X / Instagram 需要代理时才填（香港、新加坡的机器一般不用）：
# HTTPS_PROXY=http://127.0.0.1:7890
